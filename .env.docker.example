# ---------------------------------------------------------------------------
# Variables para los contenedores. Copiar como `.env.docker`:
#
#   cp .env.docker.example .env.docker
#
# NO se hornea en la imagen (está en .dockerignore): docker compose la inyecta
# en tiempo de ejecución con `env_file`.
#
# Es un archivo distinto de `.env` a propósito. `.env` apunta a la base que usas
# desde tu máquina (Supabase, PostgreSQL local); este apunta al servicio `db`
# de la red interna de compose. Mezclarlos haría que las migraciones corrieran
# contra la base equivocada.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000

# --- Base de datos ---------------------------------------------------------
# `db` es el NOMBRE DEL SERVICIO en docker-compose.yml, no un host de internet:
# dentro de la red de compose ese nombre resuelve al contenedor de PostgreSQL.
# El puerto es 5432 (el interno), no el 5433 que se publica hacia tu máquina.
# Las credenciales deben coincidir con las del servicio `db`.
DATABASE_URL=postgres://jfm:jfm_local_dev@db:5432/ejgh_autoimport

# El PostgreSQL local del compose no usa TLS. Contra Supabase u otro proveedor
# gestionado, esto va en `true`.
DB_SSL=false
DB_POOL_MAX=10

# --- Autenticación ---------------------------------------------------------
# CÁMBIALO. Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h
JWT_ISSUER=jfm-automanager
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

BCRYPT_SALT_ROUNDS=10

# --- Logs ------------------------------------------------------------------
# En el contenedor la salida es JSON en una línea por evento, apta para
# `docker compose logs` y para cualquier agregador.
LOG_LEVEL=info

# --- CORS ------------------------------------------------------------------
# El origen del frontend. En producción no dejes `*`.
CORS_ORIGINS=*

# --- Administrador inicial (solo lo usa el servicio `seed`) ----------------
SEED_ADMIN_EMAIL=admin@ejghautoimport.com
SEED_ADMIN_PASSWORD=Admin123*
SEED_ADMIN_FIRST_NAME=Administrador
SEED_ADMIN_LAST_NAME=General
