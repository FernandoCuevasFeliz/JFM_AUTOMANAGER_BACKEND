# ---------------------------------------------------------------------------
# JFM AutoManager — Backend
# Copia este archivo como `.env` y ajusta los valores.
# ---------------------------------------------------------------------------

# Entorno de ejecucion: development | test | production
NODE_ENV=development

# Puerto HTTP del servidor
PORT=3000

# --- Base de datos PostgreSQL ---------------------------------------------
# Cadena de conexion completa (tiene prioridad sobre las variables sueltas)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ejgh_autoimport

# Tamano maximo del pool de conexiones
DB_POOL_MAX=10

# Activar SSL contra la base de datos (true en proveedores gestionados)
DB_SSL=false

# --- Autenticacion JWT -----------------------------------------------------
# Secreto de firma. MINIMO 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
# Vigencia del access token (formato de `ms`: 15m, 1h, 7d)
JWT_EXPIRES_IN=8h
JWT_ISSUER=jfm-automanager

# Costo de bcrypt para hashear contrasenas (10-12 recomendado)
BCRYPT_SALT_ROUNDS=10

# --- Logs ------------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- CORS ------------------------------------------------------------------
# Origenes permitidos separados por coma, o * para permitir todos
CORS_ORIGINS=*

# --- Seed del usuario administrador inicial (npm run db:seed) --------------
SEED_ADMIN_EMAIL=admin@ejghautoimport.com
SEED_ADMIN_PASSWORD=Admin123*
SEED_ADMIN_FIRST_NAME=Administrador
SEED_ADMIN_LAST_NAME=General
